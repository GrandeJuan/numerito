# ─── Docker compose (dev) ──────────────────────────────────────────────
# Todos tienen default sensato — copiá a .env solo si necesitás overridear.

# Puertos expuestos en el host
BACKEND_PORT=5101
FRONTEND_PORT=5100

# Base de datos PostgreSQL (apunta al Postgres del host por default)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=numerito

# Auth (NestJS JWT) — cambiar en prod
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# URLs públicas
FRONTEND_URL=http://127.0.0.1:5100,http://localhost:5100
NEXT_PUBLIC_API_URL=http://127.0.0.1:5101/api
NEXT_PUBLIC_SHOW_DEV_USERS=true

NODE_ENV=production

# Scraper (dev usa DockerTaskLauncher; prod, AwsFargateTaskLauncher via ECS_CLUSTER_ARN)
INGESTA_SECRET=dev-ingesta-secret-change-in-production
SCRAPER_IMAGE=numerito-scraper:latest
SCRAPER_BACKEND_URL=http://host.docker.internal:5101

# ─── Integraciones (opcionales en dev) ─────────────────────────────────

# AWS S3 (documentos)
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS SES (email)
EMAIL_FROM=noreply@numerito.com

# Redis (colas, cache)
REDIS_URL=redis://localhost:6379
