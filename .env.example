# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/numerito"

# Auth (NestJS JWT)
JWT_SECRET="cambiar-por-un-secret-seguro"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Frontend URL (para CORS)
FRONTEND_URL="http://localhost:3000"

# Backend URL (para el frontend)
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# AWS S3 (documentos)
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Email (AWS SES)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@numerito.com"

# Redis (colas, cache)
REDIS_URL="redis://localhost:6379"
